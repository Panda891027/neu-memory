{
  "name": "open-memory-tool",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage/in-memory": {
      "types": "./dist/storage/in-memory.d.ts",
      "import": "./dist/storage/in-memory.js"
    },
    "./storage/node-fs": {
      "types": "./dist/storage/node-fs.d.ts",
      "import": "./dist/storage/node-fs.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Yanzhen Yu <yanzhen@arcfra.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@ax-llm/ax": "^14.0.37",
    "@biomejs/biome": "1.9.4",
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3",
    "undici": "^7.16.0",
    "vitest": "^4.0.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.39",
    "@ai-sdk/openai-compatible": "^1.0.24",
    "@openrouter/ai-sdk-provider": "^1.2.0",
    "ai": "^5.0.82",
    "zod": "^4.1.12"
  }
}
